@section Scripts {

    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css"
          rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>

    <script>

        document.addEventListener('DOMContentLoaded', function() {

            /*
             * ---------------------------------------------------------
             * Tom Select (Búsqueda y filtrado habilitados)
             * ---------------------------------------------------------
             */

            new TomSelect("#SelectedCountryCode", {
                create: false,
                sortField: {
                    field: "text",
                    direction: "asc"
                },
                placeholder: "Escribe para buscar un país..."
            });


            /*
             * ---------------------------------------------------------
             * Elementos
             * ---------------------------------------------------------
             */

            var form = document.getElementById('tariff-form');

            var countrySelect =
                document.getElementById('SelectedCountryCode');

            var weightInput =
                document.getElementById('Weight');

            var countryControl =
                document.getElementById('country-control');

            var weightControl =
                document.getElementById('weight-control');

            var countryError =
                document.getElementById('country-error');

            var weightError =
                document.getElementById('weight-error');

            var calcButton =
                document.getElementById('calc-button');


            /*
             * ---------------------------------------------------------
             * Estado de los campos
             * ---------------------------------------------------------
             */

            function setFieldState(control, errorEl, isValid) {

                control.classList.toggle(
                    'has-error',
                    !isValid
                );

                errorEl.classList.toggle(
                    'show',
                    !isValid
                );

            }


            /*
             * ---------------------------------------------------------
             * Validación
             * ---------------------------------------------------------
             */

            form.addEventListener('submit', function(evt) {

                var isCountryValid =
                    !!countrySelect.value;

                var weightValue =
                    parseFloat(weightInput.value);

                var isWeightValid =
                    !isNaN(weightValue) &&
                    weightValue > 0;


                setFieldState(
                    countryControl,
                    countryError,
                    isCountryValid
                );

                setFieldState(
                    weightControl,
                    weightError,
                    isWeightValid
                );


                if (!isCountryValid || !isWeightValid) {

                    evt.preventDefault();

                    if (isCountryValid) {
                        weightInput.focus();
                    } else {
                        countrySelect.focus();
                    }

                    return;
                }


                /*
                 * Estado de carga
                 */

                calcButton.classList.add('is-loading');

                calcButton
                    .querySelector('.cta-label')
                    .textContent = 'Calculando tarifa...';

                calcButton.disabled = true;

            });


            /*
             * ---------------------------------------------------------
             * Limpiar errores mientras el usuario corrige
             * ---------------------------------------------------------
             */

            countrySelect.addEventListener(
                'change',
                function() {

                    if (countrySelect.value) {

                        setFieldState(
                            countryControl,
                            countryError,
                            true
                        );

                    }

                }
            );


            weightInput.addEventListener(
                'input',
                function() {

                    var value =
                        parseFloat(weightInput.value);

                    if (!isNaN(value) && value > 0) {

                        setFieldState(
                            weightControl,
                            weightError,
                            true
                        );

                    }

                }
            );

        });

    </script>
}