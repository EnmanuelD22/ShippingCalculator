@model ShippingCalculator.Web.Models.TariffFormViewModel

@{
    ViewData["Title"] = "Cálculo de Tarifas";
}

<section class="hero">
    <div class="hero-route" aria-hidden="true">
        <svg viewBox="0 0 900 80" preserveAspectRatio="none">
            <path d="M20,58 C220,8 680,8 880,58" />
        </svg>
        <span class="route-pulse"></span>
    </div>

    <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Cotización rápida y precisa
    </div>

    <h1 class="hero-title">
        Cotizador <span>Internacional</span>
    </h1>

    <p class="hero-subtitle">
        Calcula el costo estimado de envío de tu paquete de forma rápida,
        sencilla y precisa.
    </p>
</section>


<section class="calculator-area">

    <div class="quote-card">

        <div class="quote-header">
            <div class="quote-icon">
                <i class="bi bi-box-seam-fill"></i>
            </div>

            <div>
                <h2>Calcula tu envío</h2>
                <p>Introduce los datos de tu paquete para obtener una tarifa.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="server-alert" role="alert">
                <span class="server-alert-icon">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </span>

                <div>
                    <strong>No pudimos procesar el cálculo</strong>
                    <span>@Model.ErrorMessage</span>
                </div>
            </div>
        }

        <form asp-action="Index" method="post" id="tariff-form" novalidate>

            <div class="field-row">

                <!-- País -->
                <div class="field">

                    <label class="field-label" for="SelectedCountryCode">
                        <span>
                            <i class="bi bi-globe2"></i>
                            País de destino
                        </span>
                        <small>Obligatorio</small>
                    </label>

                    <div class="field-control" id="country-control">
                        <span class="field-icon" aria-hidden="true">
                            <i class="bi bi-geo-alt"></i>
                        </span>

                        <select asp-for="SelectedCountryCode"
                                id="SelectedCountryCode"
                                class="form-input"
                                required
                                aria-describedby="country-error">

                            <option value="" disabled selected>
                                Selecciona un país
                            </option>

                            @if (Model.AvailableCountries != null)
                            {
                                @foreach (var country in Model.AvailableCountries)
                                {
                                    <option value="@country.Code">
                                        @country.Name — $@country.RatePerKg/kg
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <p class="field-helper">
                        Selecciona o busca el destino de tu paquete.
                    </p>

                    <p class="field-error"
                       id="country-error"
                       role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        Selecciona un país de destino.
                    </p>

                </div>


                <!-- Peso -->
                <div class="field">

                    <label class="field-label" for="Weight">
                        <span>
                            <i class="bi bi-box-seam"></i>
                            Peso del paquete
                        </span>
                        <small>Obligatorio</small>
                    </label>

                    <div class="field-control" id="weight-control">

                        <span class="field-icon" aria-hidden="true">
                            <i class="bi bi-box"></i>
                        </span>

                        <input asp-for="Weight"
                               id="Weight"
                               type="number"
                               step="0.1"
                               min="0.1"
                               class="form-input"
                               placeholder="Ej. 2.50"
                               required
                               aria-describedby="weight-error" />

                        <span class="field-unit">
                            kg
                        </span>

                    </div>

                    <p class="field-helper">
                        Introduce el peso total del paquete.
                    </p>

                    <p class="field-error"
                       id="weight-error"
                       role="alert">
                        <i class="bi bi-exclamation-circle"></i>
                        Introduce un peso válido.
                    </p>

                </div>

            </div>


            <div class="form-action">

                <button type="submit"
                        class="cta-button"
                        id="calc-button">

                    <span class="cta-icon">
                        <i class="bi bi-calculator"></i>
                    </span>

                    <span class="cta-spinner"
                          aria-hidden="true"></span>

                    <span class="cta-label">
                        Calcular tarifa de envío
                    </span>

                    <span class="cta-arrow">
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </button>

                <p class="form-note">
                    <i class="bi bi-shield-check"></i>
                    Obtén una estimación de tu tarifa en segundos.
                </p>

            </div>

        </form>


        <!-- Resultado -->
        @if (Model.Result != null)
        {
            <div class="result-card"
                 role="status"
                 aria-live="polite">

                <div class="result-inner">

                    <div class="result-top">

                        <div class="result-status">
                            <span class="status-dot">
                                <i class="bi bi-check2"></i>
                            </span>

                            <div>
                                <strong>Tarifa calculada correctamente</strong>
                                <span>Resumen de tu cotización</span>
                            </div>
                        </div>

                        <span class="result-badge">
                            <i class="bi bi-check-circle-fill"></i>
                            Listo
                        </span>

                    </div>


                    <div class="result-route" aria-hidden="true">

                        <div class="route-point">
                            <span class="route-point-icon">
                                <i class="bi bi-box-seam-fill"></i>
                            </span>
                            <span>Paquete</span>
                        </div>

                        <div class="route-line">
                            <span></span>
                        </div>

                        <div class="route-point destination">
                            <span class="route-point-icon">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>
                            <span>Destino</span>
                        </div>

                    </div>


                    <div class="result-price-container">

                        <p class="result-price-label">
                            Tarifa estimada
                        </p>

                        <p class="result-price">
                            <small>USD</small>
                            @Model.Result.TotalCost.ToString("N2")
                        </p>

                    </div>


                    <div class="result-meta">

                        <div class="result-meta-item">

                            <span class="meta-icon">
                                <i class="bi bi-globe2"></i>
                            </span>

                            <div>
                                <span class="meta-label">
                                    Destino
                                </span>

                                <span class="meta-value">
                                    @Model.Result.CountryName
                                </span>
                            </div>

                        </div>


                        <div class="result-meta-item">

                            <span class="meta-icon">
                                <i class="bi bi-box-seam"></i>
                            </span>

                            <div>
                                <span class="meta-label">
                                    Peso
                                </span>

                                <span class="meta-value">
                                    @Model.Result.Weight kg
                                </span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }
        else if (string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="empty-result">

                <div class="empty-result-icon">
                    <i class="bi bi-calculator"></i>
                </div>

                <div>
                    <strong>Tu tarifa aparecerá aquí</strong>
                    <span>
                        Completa el país de destino y el peso del paquete.
                    </span>
                </div>

            </div>
        }

    </div>

</section>


