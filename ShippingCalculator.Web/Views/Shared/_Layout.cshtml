<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ShippingCalculator</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =========================================================
         HEADER
    ========================================================== -->
    <header>
        <nav class="navbar-custom">
            <div class="container navbar-inner">

                <a class="brand"
                   asp-controller="Tariff"
                   asp-action="Index"
                   aria-label="ShippingCalculator">

                    <span class="brand-mark">
                        <i class="bi bi-box-seam-fill"></i>
                    </span>

                    <span class="brand-text">
                        Shipping<span>Calculator</span>
                    </span>
                </a>

                <div class="brand-tag">
                    <span class="brand-tag-icon">
                        <i class="bi bi-shield-check"></i>
                    </span>

                    <span>Envíos internacionales</span>
                </div>

            </div>
        </nav>
    </header>


    <!-- =========================================================
         CONTENIDO PRINCIPAL
    ========================================================== -->
    <main class="site-main">

        <!-- Decoración de fondo -->
        <div class="shipping-background" aria-hidden="true">

            <!-- Avión -->
            <div class="background-plane">
                <svg viewBox="0 0 180 100"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M12 54
                    L70 47
                    L109 17
                    C113 14 118 15 121 18
                    L124 22
                    L96 48
                    L156 47
                    C163 47 168 51 171 56
                    L156 61
                    L96 57
                    L122 82
                    L117 86
                    C114 89 109 88 106 85
                    L70 59
                    L12 64
                    C7 64 4 60 5 57
                    C6 55 8 54 12 54Z"
                          fill="currentColor" />

                    <path d="M68 47 L58 29 L63 27 L82 45"
                          fill="currentColor"
                          opacity=".75" />

                </svg>
            </div>


            <!-- Ruta punteada -->
            <div class="background-route">
                <svg viewBox="0 0 900 260"
                     preserveAspectRatio="none"
                     xmlns="http://www.w3.org/2000/svg">

                    <path d="M70 205
                    C230 40 570 40 830 185"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-dasharray="6 10" />
                </svg>
            </div>


            <!-- Caja -->
            <div class="background-package">

                <svg viewBox="0 0 150 150"
                     xmlns="http://www.w3.org/2000/svg">

                    <!-- Sombra -->
                    <ellipse cx="76"
                             cy="128"
                             rx="45"
                             ry="8"
                             fill="#0b1830"
                             opacity=".10" />

                    <!-- Parte superior -->
                    <polygon points="35,48 75,27 116,48 75,70"
                             fill="#f2c99a" />

                    <!-- Lado izquierdo -->
                    <polygon points="35,48 75,70 75,116 35,94"
                             fill="#dd935a" />

                    <!-- Lado derecho -->
                    <polygon points="75,70 116,48 116,94 75,116"
                             fill="#b06e3c" />

                    <!-- Cinta -->
                    <polygon points="68,31 82,38 82,108 68,116"
                             fill="#e9b777"
                             opacity=".9" />

                    <!-- Línea de cierre -->
                    <line x1="75"
                          y1="70"
                          x2="75"
                          y2="116"
                          stroke="#8e572f"
                          stroke-width="1.5"
                          opacity=".35" />

                </svg>

            </div>

        </div>


        <div class="container main-container">

            <div class="quote-shell">
                @RenderBody()
            </div>

        </div>

    </main>


    <!-- =========================================================
         FOOTER
    ========================================================== -->
    <footer class="site-footer">

        <div class="container">

            <span>
                © @DateTime.Now.Year ShippingCalculator
            </span>

            <span class="footer-separator">•</span>

            <span>
                Arquitectura monolítica en capas
            </span>

        </div>

    </footer>


    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>